{
  "name": "todo-pwa",
  "private": true,
  "scripts": {
    "test": "node --test tests/*.test.js",
    "eval:jev": "node tools/evaluate-jev.js",
    "eval:jev:check": "node tools/evaluate-jev.js --check",
    "test:emulators": "firebase emulators:exec --project demo-todo --only auth,database \"node --test --test-force-exit tests/emulator/*.test.js\""
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^4.0.0",
    "firebase": "^11.0.0",
    "firebase-tools": "^15.31.0"
  }
}
